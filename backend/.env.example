NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_public   # NUNCA la service_role
GROQ_API_KEY=gsk_...                                  # solo servidor (Vercel: Sensitive)
# Orígenes web permitidos (CORS) para Flutter web, separados por coma, sin barra final
ALLOWED_ORIGINS=https://tu-app-flutter.vercel.app

# --- Facturación electrónica SUNAT ---
SUPABASE_SERVICE_ROLE_KEY=...        # SOLO servidor (Sensitive). Se usa únicamente en src/lib/supabase/admin.ts
LYCET_URL=https://facturacion.tudominio.com
LYCET_API_KEY=...                     # la imprime infra/lycet/bootstrap.sh
# LYCET_TOKEN=                        # solo desarrollo local directo contra Lycet

# --- Correo (Resend, plan gratis 3 000/mes) ---
RESEND_API_KEY=re_...                                  # solo servidor (Vercel: Sensitive)
# Sin dominio verificado Resend solo envía a TU correo de cuenta. Con dominio verificado:
# RESEND_FROM=Mi Negocio <facturas@tudominio.com>

# --- Modelo de texto de Groq (opcional) ---
# LLM_MODEL=openai/gpt-oss-120b   # solo si quieres forzar otro modelo

# Aviso por correo al terminar una importación masiva (cron diario y Database Webhook). Genera una cadena larga al azar.
# CRON_SECRET=

# --- Catálogo: eliminación opcional de fondo con IA ---
# REMOVE_BG_API_KEY=    # Solo servidor; X-API-Key de https://www.remove.bg/api (servicio por créditos)
# Al faltar esta clave, el botón permite conservar la fotografía original sin bloquear el producto.
# El proveedor anuncia migración de API a Leonardo.Ai desde el 1 de diciembre de 2026.
#
# --- Negocio Pro (migración 20261101_negocio_pro.sql) ---
# Clave para CIFRAR el token de Mercado Pago de cada empresa (32 bytes en base64). Genérala UNA vez y no la cambies:
#   openssl rand -base64 32
SECRETS_KEY=
# URL pública del backend para los enlaces /cotizacion y /pagar y el webhook de Mercado Pago (sin barra final).
# Si no la pones se usa VERCEL_PROJECT_PRODUCTION_URL automáticamente.
# PUBLIC_BASE_URL=https://factura-voz-two.vercel.app
# Modelo con visión de Groq para el escáner (opcional; por defecto qwen/qwen3.8-27b)
# VISION_MODEL=qwen/qwen3.8-27b
# Tope de correos de cobranza por día (plan gratis de Resend: 100/día)
# COLLECTIONS_DAILY_LIMIT=80
# CRON_SECRET ahora también protege /api/cron/collections (obligatorio para la cobranza automática).

# ═══════════════ v2.0 ═══════════════
# --- Licencias: Solvex Hub (vacías = MODO DESARROLLO: todo habilitado y marcado "desarrollo") ---
# SOLVEX_HUB_URL=https://hub.solvex.pe
# SOLVEX_INSTANCE_ID=ins_xxxxxxxxxxxxxxxxxxxx            # id de la instancia "FacturaVoz producción" en el panel del Hub (aud del token)
# SOLVEX_API_KEY=slxk_xxxxxxxx_...                       # clave de la instancia (se muestra UNA vez al crearla)   (Sensitive)
# SOLVEX_WEBHOOK_SECRET=...                              # secreto del webhook de la instancia                      (Sensitive)
# SOLVEX_PUBLIC_KEYS=AbC...=                             # llave(s) pública(s) Ed25519 "raw_b64" de /.well-known/solvex-license-keys.json (coma si hay varias)
# SOLVEX_PLANS_URL=https://solvex.pe/#precios            # adónde enviar al cliente para elegir plan

# --- Consulta DNI / RUC (v3: APISPERU por defecto; si falta el token, la app deja escribir a mano) ---
# El token va SOLO aquí (Vercel → Settings → Environment Variables). Nunca en el código, la app ni los registros.
# DOC_API_TOKEN=                                          # token de dniruc.apisperu.com   (Sensitive)
# Opcionales: si no se definen se usan estas plantillas ({n} = número, {token} = DOC_API_TOKEN).
# DOC_API_DNI_URL=https://dniruc.apisperu.com/api/v1/dni/{n}?token={token}
# DOC_API_RUC_URL=https://dniruc.apisperu.com/api/v1/ruc/{n}?token={token}
# (Otro proveedor sin {token} en la plantilla → el token se envía como "Authorization: Bearer".)

# --- Voz premium del Copiloto (ElevenLabs) · v3 ---
# Solo el servidor llama a ElevenLabs (/api/tts). Si falta la clave, la app usa la voz del teléfono y avisa.
# ELEVENLABS_API_KEY=                                     # (Sensitive) NUNCA en la app ni en el repositorio
# ELEVENLABS_VOICE_ID=erWYIIRQTXR88ZsA9w1X                # voz por defecto (no es secreto)
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5                   # el más barato con buen español (0,5 crédito/carácter)
# TTS_GLOBAL_DAILY_CHARS=600                              # tope diario de TODAS las empresas juntas (protege tu plan)

# --- Copiloto (Groq) · v3 ---
# COPILOT_MODEL=openai/gpt-oss-20b                        # opcional: el más rápido; si falla se usa otro automáticamente

# --- Tipo de cambio SUNAT para facturar en dólares (opcional) ---
# FX_API_URL=https://api.decolecta.com/v1/tipo-cambio/sunat?date={date}
# FX_API_TOKEN=                                           # token propio del proveedor de tipo de cambio (no se reutiliza DOC_API_TOKEN)
